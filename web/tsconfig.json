{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// svelte-check resolves .svelte files through paths, not package.json imports.
		"paths": { "#lib": ["./src/lib/index.ts"], "#lib/*": ["./src/lib/*"] }
	},
	"include": ["src", "vite.config.ts"]
}

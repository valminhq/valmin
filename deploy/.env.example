# Copy to deploy/.env and follow docs/installation.md.
# Keep this file valid shell syntax: prepare-host.sh also reads it.

# Browser hostname or LAN IP, without https://, a port, or a path.
# LAN example: VALMIN_DOMAIN=192.168.1.100
VALMIN_DOMAIN=valmin.example.com

# Absolute data directory on the Docker host. Pass the same path to prepare-host.sh.
VALMIN_HOST_DATA_ROOT=/srv/valmin

# Built from this checkout by: make panel-image game-image
# For registry deployments, replace these with available, digest-pinned images.
VALMIN_IMAGE=valmin/valmind:dev
VALMIN_GAME_IMAGE=valmin/valheim:dev

# For a LAN IP or private hostname, use: VALMIN_TLS='tls internal'
# Leave empty for a public domain that Caddy can validate. See docs/installation.md.
VALMIN_TLS=

# Optional image overrides. The game and SteamCMD images must exist on the host
# before the daemon uses them; prepare-host.sh obtains missing images.
#VALMIN_STEAMCMD_IMAGE=steamcmd/steamcmd:latest
#VALMIN_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
#VALMIN_CADDY_IMAGE=caddy:2-alpine

# Host ports. A nonstandard HTTPS port also needs an external URL override:
# see docs/configuration.md#use-a-different-https-port.
#VALMIN_HTTP_PORT=80
#VALMIN_HTTPS_PORT=443

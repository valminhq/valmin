# Copy to .env beside compose.yaml and fill in. Every value here is boot-time, operator-owned
# configuration (10 §1): nothing in this file has a settings screen, and nothing a settings
# screen owns belongs here.

# The hostname the panel is served on. It is also the origin the SPA is checked against, so
# it is the address people actually browse to, not an internal alias.
VALMIN_DOMAIN=valmin.example.com

# Where the panel keeps everything, as the HOST sees it: worlds, backups, the database, the
# master key. The panel verifies this path with a token round trip through a throwaway
# container on every start and refuses to run if it does not resolve (10 §1.2).
VALMIN_HOST_DATA_ROOT=/srv/valmin

# Pinned by digest in production. A tag is a moving target, and an image that changes under
# a restart is an upgrade nobody chose.
VALMIN_IMAGE=ghcr.io/valminhq/valmind:v1.0.0
VALMIN_GAME_IMAGE=ghcr.io/valminhq/valheim:v1.0.0

# The gid of /var/run/docker.sock on this host. `stat -c %g /var/run/docker.sock` prints it,
# and prepare-host.sh reports it too.
VALMIN_DOCKER_GID=

# Set to `tls internal` for a LAN hostname no public CA can validate. Leave empty for a real
# domain, which gets a real certificate automatically.
VALMIN_TLS=

# Only if 80 and 443 are already taken on this host.
#VALMIN_HTTP_PORT=80
#VALMIN_HTTPS_PORT=443

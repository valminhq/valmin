# Terminates TLS for the panel and proxies everything to it.
#
# For certificate expiry emails, add a global option above the site block:
#
#	{
#		email you@example.com
#	}

# Clients send no SNI to an IP address, so Caddy needs a certificate to fall back to.
{
	default_sni {$VALMIN_DOMAIN}
}

{$VALMIN_DOMAIN} {
	# Empty for a public certificate, or `tls internal` for Caddy's local CA.
	{$VALMIN_TLS}

	header Strict-Transport-Security "{$VALMIN_HSTS:max-age=31536000}"

	# Above the panel's own upload limits, so the panel reports a rejected upload.
	request_body {
		max_size 5GB
	}

	# Backup archives are already compressed, and the WebSocket stream is not compressed.
	@compressible {
		not path /api/v1/instances/*/backups/*/download
		not path /api/v1/ws
	}
	encode @compressible zstd gzip

	# A route runs its directives in the order written. The client's copy of the sign-in header
	# is dropped first, so only an SSO gateway added below it can set the header.
	# See docs/configuration.md#sign-in-through-a-reverse-proxy.
	route {
		request_header -{$VALMIN_PROXY_AUTH_HEADER:Remote-User}

		# forward_auth goes here.

		reverse_proxy valmind:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
